{
	"name": "oocxx",
	"compatibility_date": "2025-10-08",
	"main": "./worker.js",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "oocxx.com",
			"custom_domain": true
		},
		{
			"pattern": "www.oocxx.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	}
}
