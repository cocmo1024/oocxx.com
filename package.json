{
	"name": "oocxx",
	"description": "The source repository for oocxx.com.",
	"cloudflare": {
		"label": "Hugo PaperMod Blog",
		"products": [
			"Workers"
		],
		"categories": [],
		"publish": true
	},
	"devDependencies": {
		"hugo-extended": "0.162.1",
		"wrangler": "^4.97.0"
	},
	"private": true,
	"scripts": {
		"audit:content": "node ./scripts/content-quality-audit.mjs",
		"build": "hugo --gc --minify --cleanDestinationDir --destination dist",
		"check": "npm run audit:content && npm run build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "hugo server -D --bind 127.0.0.1 --port 1313 --baseURL http://127.0.0.1:1313/",
		"new:post": "hugo new content",
		"preview": "npm run build && wrangler dev"
	},
	"type": "module"
}
