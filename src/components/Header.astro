---
import HeaderLink from "./HeaderLink.astro";
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from "../consts";
---

<header class="site-header">
	<a class="brand" href="/" aria-label={`${SITE_TITLE} 首页`}>
		<span class="brand-mark" aria-hidden="true">O</span>
		<span>{SITE_TITLE}</span>
	</a>

	<nav class="site-nav" aria-label="主导航">
		<HeaderLink href="/">首页</HeaderLink>
		<HeaderLink href="/blog">文章</HeaderLink>
		<HeaderLink href="/about">关于</HeaderLink>
		<a href="/rss.xml">RSS</a>
	</nav>

	<div class="header-copy">
		<p>{SITE_DESCRIPTION}</p>
		<p>{SITE_TAGLINE}</p>
	</div>
</header>
