---
import { getCollection } from "astro:content";
import PostPreviewCard from "../components/PostPreviewCard.astro";
import ClassicShell from "../layouts/ClassicShell.astro";
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from "../consts";
import { getFeaturedPost, sortPosts } from "../lib/content";
import { getItemListSchema } from "../lib/seo";

const posts = sortPosts(await getCollection("blog"));
const featuredPost = getFeaturedPost(posts);
const latestPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 3);
const homeListId = `${SITE_URL}/#latest`;
const homeSchema = getItemListSchema(
	homeListId,
	posts.slice(0, 6).map((post) => ({
		name: post.data.title,
		url: `/blog/${post.id}/`,
	})),
);
---

<ClassicShell
	title={SITE_TITLE}
	description={SITE_DESCRIPTION}
	image="/images/writing-desk.webp"
	schemaType="Blog"
	mainEntityId={homeListId}
	schema={homeSchema}
>
	<section class="home-hero">
		<div class="home-hero-copy">
			<p class="eyebrow">Personal Blog</p>
			<h1>把复杂写清楚。</h1>
			<p>
				这里是 OOCXX 的个人博客。没有复杂栏目，没有增长焦虑，只保存一些经过筛选的观察、工具、生活片段和长期思考。
			</p>
			<div class="hero-actions">
				<a href="/blog">阅读文章</a>
				<a href="/about">关于这里</a>
			</div>
		</div>
		<figure class="hero-visual">
			<img
				src="/images/writing-desk.webp"
				alt="一张安静的写字桌，上面有笔记本、笔和纸张"
				width={1400}
				height={875}
				loading="eager"
				decoding="async"
			/>
		</figure>
	</section>

	{featuredPost && (
		<section class="featured-section">
			<div class="section-title">
				<p class="eyebrow">置顶</p>
				<h2>最近想反复提醒自己的事</h2>
			</div>
			<PostPreviewCard post={featuredPost} featured={true} />
		</section>
	)}

	<section class="post-section" id="latest">
		<div class="section-title">
			<p class="eyebrow">Latest</p>
			<h2>最新文章</h2>
		</div>
		<div class="post-list">
			{latestPosts.map((post) => (
				<PostPreviewCard post={post} />
			))}
		</div>
	</section>
</ClassicShell>
