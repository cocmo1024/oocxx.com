---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
const latinWords = post.body.match(/[A-Za-z0-9]+(?:['-][A-Za-z0-9]+)*/g)?.length ?? 0;
const cjkChars = post.body.match(/[\u3400-\u9fff]/g)?.length ?? 0;
const wordCount = latinWords + Math.round(cjkChars / 2);
---

<BlogPost {...post.data} postId={post.id} wordCount={wordCount}>
	<Content />
</BlogPost>
