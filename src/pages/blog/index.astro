---
import { getCollection } from "astro:content";
import PostPreviewCard from "../../components/PostPreviewCard.astro";
import ClassicShell from "../../layouts/ClassicShell.astro";
import { SITE_TITLE, SITE_URL } from "../../consts";
import { sortPosts } from "../../lib/content";
import { getItemListSchema } from "../../lib/seo";

const posts = sortPosts(await getCollection("blog"));
const archiveId = `${SITE_URL}/blog/#archive`;
const archiveSchema = getItemListSchema(
	archiveId,
	posts.map((post) => ({
		name: post.data.title,
		url: `/blog/${post.id}/`,
	})),
);
---

<ClassicShell
	title={`文章 | ${SITE_TITLE}`}
	description="OOCXX 的个人博客归档。"
	schemaType="CollectionPage"
	breadcrumbItems={[
		{ name: "首页", item: "/" },
		{ name: "文章" },
	]}
	mainEntityId={archiveId}
	schema={archiveSchema}
>
	<section class="page-heading">
		<p class="eyebrow">Archive</p>
		<h1>文章</h1>
		<p>所有文字按发布时间倒序排列。数量不重要，留下来的质量更重要。</p>
	</section>

	<section class="post-section" id="archive">
		<div class="post-list">
			{posts.map((post) => (
				<PostPreviewCard post={post} />
			))}
		</div>
	</section>
</ClassicShell>
