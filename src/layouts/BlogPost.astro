---
import { getCollection, type CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import ClassicShell from "./ClassicShell.astro";
import { SITE_AUTHOR, SITE_TITLE, SITE_URL } from "../consts";
import { getPostNeighbors, getReadingMinutes, sortPosts } from "../lib/content";
import { PERSON_SCHEMA_ID, WEBSITE_SCHEMA_ID, absoluteUrl } from "../lib/seo";

type Props = CollectionEntry<"blog">["data"] & {
	postId: string;
	wordCount?: number;
};

const { title, description, pubDate, updatedDate, heroImage, tags, postId } = Astro.props;
const { wordCount } = Astro.props;
const pageURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).toString();
const posts = sortPosts(await getCollection("blog"));
const neighbors = getPostNeighbors(posts, postId);
const minutes = getReadingMinutes(wordCount);

const articleSchema = {
	"@type": "BlogPosting",
	"@id": `${pageURL}#article`,
	url: pageURL,
	headline: title,
	description,
	inLanguage: "zh-CN",
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	image: heroImage ? [absoluteUrl(heroImage)] : undefined,
	author: {
		"@id": PERSON_SCHEMA_ID,
	},
	publisher: {
		"@id": PERSON_SCHEMA_ID,
	},
	mainEntityOfPage: { "@id": `${pageURL}#webpage` },
	isPartOf: { "@id": WEBSITE_SCHEMA_ID },
	keywords: tags.join(", "),
	wordCount: wordCount && wordCount > 0 ? wordCount : undefined,
};
---

<ClassicShell
	title={`${title} | ${SITE_TITLE}`}
	description={description}
	image={heroImage}
	ogType="article"
	publishedTime={pubDate.toISOString()}
	modifiedTime={(updatedDate ?? pubDate).toISOString()}
	author={SITE_AUTHOR}
	articleTags={tags}
	breadcrumbItems={[
		{ name: "首页", item: "/" },
		{ name: "文章", item: "/blog/" },
		{ name: title },
	]}
	mainEntityId={`${pageURL}#article`}
	schema={articleSchema}
>
	<article class="article">
		<a class="back-link" href="/blog">← 文章</a>

		<header class="article-header">
			<p class="article-meta">
				<FormattedDate date={pubDate} />
				{minutes && <span>{minutes} 分钟读完</span>}
			</p>
			<h1>{title}</h1>
			<p>{description}</p>
			{tags.length > 0 && (
				<ul class="article-tags" aria-label="标签">
					{tags.map((tag) => (
						<li>{tag}</li>
					))}
				</ul>
			)}
		</header>

		{heroImage && (
			<figure class="article-image">
				<img src={heroImage} alt="" width={1400} height={875} loading="eager" decoding="async" />
			</figure>
		)}

		<div class="prose">
			<slot />
		</div>

		<nav class="post-nav" aria-label="文章导航">
			{neighbors.older && (
				<a href={`/blog/${neighbors.older.id}/`}>
					<span>上一篇</span>
					<strong>{neighbors.older.data.title}</strong>
				</a>
			)}
			{neighbors.newer && (
				<a href={`/blog/${neighbors.newer.id}/`}>
					<span>下一篇</span>
					<strong>{neighbors.newer.data.title}</strong>
				</a>
			)}
		</nav>
	</article>
</ClassicShell>
