---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_LANGUAGE, SITE_TITLE, SITE_URL } from "../consts";
import {
	buildSchemaGraph,
	absoluteUrl,
	getBreadcrumbSchema,
	getPageSchema,
	getPersonSchema,
	getWebsiteSchema,
	type BreadcrumbItem,
	type SchemaObject,
} from "../lib/seo";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	schema?: SchemaObject | SchemaObject[];
	schemaType?: string;
	breadcrumbItems?: BreadcrumbItem[];
	mainEntityId?: string;
	ogType?: "website" | "article";
	publishedTime?: string;
	modifiedTime?: string;
	author?: string;
	articleTags?: string[];
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	schema,
	schemaType = "WebPage",
	breadcrumbItems = [],
	mainEntityId,
	ogType = "website",
	publishedTime,
	modifiedTime,
	author,
	articleTags = [],
} = Astro.props;

const pageURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).toString();
const breadcrumbSchema =
	breadcrumbItems.length >= 2 ? getBreadcrumbSchema(pageURL, breadcrumbItems) : undefined;
const pageSchema = getPageSchema({
	type: schemaType,
	url: pageURL,
	name: title,
	description,
	breadcrumbId: breadcrumbSchema?.["@id"] as string | undefined,
	mainEntityId,
	image: image ? absoluteUrl(image) : undefined,
});
const schemaPayload = buildSchemaGraph(
	getPersonSchema(),
	getWebsiteSchema(),
	pageSchema,
	breadcrumbSchema,
	schema,
);
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			ogType={ogType}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			author={author}
			articleTags={articleTags}
			schema={schemaPayload}
		/>
	</head>
	<body>
		<div class="site-shell">
			<Header />
			<main>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>
